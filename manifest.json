{
  "name": "YouTube Bookmarker",
  "description": "Youtube Bookmark Extension",
  "version": "1.0",
  "manifest_version": 3,
  "action": {
    "default_title": "Open YT Bookmarker",
    "default_popup": "popup.html",
      "default_icon": {
        "16": "icons/logo.png",
        "48": "icons/logo.png",
        "128": "icons/logo.png"
        }
  },
  "icons": {
  "16": "icons/logo.png",
  "48": "icons/logo.png",
  "128": "icons/logo.png"
  },
  "permissions": ["storage", "tabs", "scripting", "webNavigation"],
  "background": {
    "service_worker": "scripts/background.js"
  },
  "web_accessible_resources": [
    {
      "resources": ["icons/bookmark-icon.png"],
      "matches": ["https://www.youtube.com/*"]
    }
  ],
  "host_permissions": [
    "https://www.youtube.com/*"
  ]
}